@ARTICLE{
   iet:/content/journals/10.1049/joe.2018.0190,
    author={Farughian,Amir and Poluektov,Anton and Pinomaa,Antti and Ahola,Jero and Kosonen,Antti and Kumpulainen,Lauri and Kauhaniemi,Kimmo},
    keywords = {phase-to-earth fault;faulted line section;network signalling;fault location methods;power line signalling;earth fault location;power networks;low-frequency band;fault occurrence;medium-voltage distribution networks;software-defined radios;},
    language = {English},
    abstract = {Fault location in power networks is important as accurate information about the faulted line section expedites system restoration following a fault occurrence. A number of fault location methods have been proposed. Methods based on injecting a signal into the network and tracking it along the feeder appear to have received limited attention. In this study, fault location methods based on network signalling are examined. Two different types of approaches are presented. The first one is based on injection on a very low-frequency band, whereas the second one is based on utilising modern modulation technologies on low-frequency band, under 500 kHz, implemented on software-defined radios. The simulation results indicate the capability of the proposed methods in determining the location of a single phase-to-earth fault in medium-voltage distribution networks.},
    title = {Power line signalling based earth fault location},
    journal = {The Journal of Engineering},
    issue = {15},
    volume = {2018},
    year = {2018},
    month = {October},
    pages = {1155-1159(4)},
    publisher ={Institution of Engineering and Technology},
    copyright = {This is an open access article published by the IET under the Creative Commons Attribution License (http://creativecommons.org/licenses/by/3.0/)},
    doi = {10.1049/joe.2018.0190},
    url = {https://doi.org/10.1049/joe.2018.0190}
}
